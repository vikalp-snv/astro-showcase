---
import "@vikalpshakya/ui/styles.css";
import "../styles/demo.css";
import { Button } from "@vikalpshakya/ui";
import { pkg } from "../lib/library";

export interface TocGroup {
  group: string;
  items: { id: string; label: string }[];
}

interface Props {
  title: string;
  description: string;
  toc?: TocGroup[];
}

const { title, description, toc } = Astro.props;
const pages = [
  { href: "/", label: "Overview" },
  { href: "/foundations/", label: "Foundations" },
  { href: "/components/", label: "Components" },
  { href: "/interactive/", label: "Interactive" },
];
const path = Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title} · {pkg.name}</title>
    <!-- Before first paint, so a dark-mode visitor never sees a light flash -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body>
    <a class="demo-skip" href="#main">Skip to content</a>
    <header class="demo-header">
      <a class="demo-brand" href="/">
        <span class="demo-brand-mark" aria-hidden="true"></span>
        <span>{pkg.name}</span>
        <span class="demo-version">v{pkg.version}</span>
      </a>
      <nav class="demo-nav" aria-label="Main">
        {
          pages.map((p) => (
            <a href={p.href} aria-current={p.href === path ? "page" : undefined}>
              {p.label}
            </a>
          ))
        }
      </nav>
      <!-- A static library Button; the vanilla script below wires it up, no React needed -->
      <Button variant="ghost" size="sm" data-theme-toggle aria-pressed="false">Dark mode</Button>
    </header>

    <div class:list={["demo-shell", { "demo-shell-toc": toc }]}>
      {
        toc && (
          <nav class="demo-toc" aria-label="On this page">
            {toc.map((g) => (
              <div>
                <p class="demo-toc-group">{g.group}</p>
                <ul>
                  {g.items.map((i) => (
                    <li>
                      <a href={`#${i.id}`}>{i.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        )
      }
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <footer class="demo-footer">
      Showcase for <code>{pkg.name}@{pkg.version}</code>, installed as a package dependency.
    </footer>
    <script>
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]"
  );

  if (toggle) {
    const sync = () => {
      const isDark = document.documentElement.classList.contains("dark");

      toggle.setAttribute("aria-pressed", String(isDark));
      toggle.textContent = isDark ? "Light mode" : "Dark mode";
    };

    sync();

    toggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");

      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {}

      sync();
    });
  }
</script>
  </body>
</html>